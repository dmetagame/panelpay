    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vercel/node": "^5.3.25",
    "typescript": "^5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
